import { useCallback, useEffect, useState } from 'react';
import {
  Alert,
  Box,
  Button,
  Card,
  CardContent,
  Chip,
  CircularProgress,
  Grid,
  Stack,
  Typography,
  TextField,
} from '@mui/material';

import PeopleIcon from '@mui/icons-material/People';
import AssignmentIcon from '@mui/icons-material/Assignment';
import ScienceIcon from '@mui/icons-material/Science';
import ImageSearchIcon from '@mui/icons-material/ImageSearch';
import RefreshIcon from '@mui/icons-material/Refresh';
import EventNoteIcon from '@mui/icons-material/EventNote';

import { useAuth } from '../auth/AuthContext';
import { patientsApi } from '../api/patients.api';
import type { Patient } from '../types/patient';
import AppointmentDetailsDialog from '../components/appointments/AppointmentDetailsDialog';
import AppointmentStatusDialog from '../components/appointments/AppointmentStatusDialog';
import AppointmentRescheduleDialog from '../components/appointments/AppointmentRescheduleDialog';
import {
  appointmentsApi,
  type Appointment,
  type AppointmentStatus,
} from '../api/appointments.api';

const TIME_ZONE = 'Africa/Addis_Ababa';

const modules = [
  { title: 'Patients', icon: <PeopleIcon color="primary" /> },
  { title: 'Encounters', icon: <AssignmentIcon color="primary" /> },
  { title: 'Laboratory', icon: <ScienceIcon color="primary" /> },
  { title: 'Radiology', icon: <ImageSearchIcon color="primary" /> },
];

function getEthiopiaDate(): string {
  const parts = new Intl.DateTimeFormat('en-US', {
    timeZone: TIME_ZONE,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).formatToParts(new Date());

  const value = (type: string) =>
    parts.find((part) => part.type === type)?.value ?? '';

  return `${value('year')}-${value('month')}-${value('day')}`;
}

function formatTime(value: string): string {
  return new Intl.DateTimeFormat('en-US', {
    timeZone: TIME_ZONE,
    hour: '2-digit',
    minute: '2-digit',
    hour12: true,
  }).format(new Date(value));
}


export default function DashboardPage() {
  const { user } = useAuth();

  const canReadAppointments =
    user?.permissions.includes('appointment.read') ?? false;

  const canReadPatient =
    user?.permissions.includes('patient.read') ?? false;

  const [patientMap, setPatientMap] =
    useState<Record<string, Patient>>({});

  const [patientLoading, setPatientLoading] = useState(false);
  const [patientError, setPatientError] = useState(false);

  const canUpdate =
    user?.permissions.includes('appointment.update') ?? false;

  const canCancel =
    user?.permissions.includes('appointment.cancel') ?? false;

  const [statusOpen, setStatusOpen] = useState(false);
  const [rescheduleOpen, setRescheduleOpen] = useState(false);

  const [detailsOpen, setDetailsOpen] = useState(false);
  const [selectedAppointment, setSelectedAppointment] =
    useState<Appointment | null>(null);
  const [detailsLoading, setDetailsLoading] = useState(false);
  const [detailsError, setDetailsError] = useState<string | null>(null);

  const [appointments, setAppointments] =
    useState<Appointment[]>([]);

  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const [selectedDate, setSelectedDate] = useState(getEthiopiaDate);

  const [currentTime, setCurrentTime] = useState(() => Date.now());

  useEffect(() => {
    const timer = window.setInterval(() => {
      setCurrentTime(Date.now());
    }, 60_000);

    return () => window.clearInterval(timer);
  }, []);

  const loadToday = useCallback(async () => {
    if (!canReadAppointments) return;

    setLoading(true);
    setError(null);

    try {
      const clinicDate = selectedDate;

      const result = await appointmentsApi.list({
        dateFrom: `${clinicDate}T00:00:00+03:00`,
        dateTo: `${clinicDate}T23:59:59.999+03:00`,
      });

      setAppointments(result);
    } catch {
      setError('Unable to load today’s appointments.');
      setAppointments([]);
    } finally {
      setLoading(false);
    }
  }, [canReadAppointments, selectedDate]);

  useEffect(() => {
    void loadToday();
  }, [loadToday]);

  useEffect(() => {
    if (!canReadPatient || !canReadAppointments) {
      setPatientMap({});
      setPatientError(false);
      setPatientLoading(false);
      return;
    }

    const ids = [...new Set(appointments.map((item) => item.patientId))];

    if (ids.length === 0) {
      setPatientMap({});
      setPatientError(false);
      setPatientLoading(false);
      return;
    }

    let cancelled = false;

    const loadPatients = async () => {
      setPatientLoading(true);
      setPatientError(false);

      const results = await Promise.allSettled(
        ids.map((id) => patientsApi.getById(id)),
      );

      if (cancelled) return;

      const nextMap: Record<string, Patient> = {};
      let failed = false;

      results.forEach((result, index) => {
        if (result.status === 'fulfilled') {
          nextMap[ids[index]] = result.value;
        } else {
          failed = true;
        }
      });

      setPatientMap(nextMap);
      setPatientError(failed);
      setPatientLoading(false);
    };

    void loadPatients();

    return () => {
      cancelled = true;
    };
  }, [appointments, canReadPatient, canReadAppointments]);

  const handleViewDetails = async (id: string) => {
    setSelectedAppointment(null);
    setDetailsError(null);
    setDetailsOpen(true);
    setDetailsLoading(true);

    try {
      const result = await appointmentsApi.getById(id);
      setSelectedAppointment(result);
    } catch {
      setDetailsError('Unable to load appointment details.');
    } finally {
      setDetailsLoading(false);
    }
  };

  const getPatientName = (patientId: string): string => {
    if (!canReadPatient) return 'Restricted';

    const patient = patientMap[patientId];

    if (!patient) return patientLoading ? 'Loading...' : 'Unavailable';

    return [
      patient.firstName,
      patient.middleName,
      patient.lastName,
    ].filter(Boolean).join(' ');
  };

  const getPatientIdentifier = (patientId: string): string => {
    if (!canReadPatient) return 'Restricted';

    const patient = patientMap[patientId];

    if (!patient) return patientLoading ? 'Loading...' : '-';

    return patient.medicalRecordNumber ||
      `Patient No: ${patient.patientNumber}`;
  };

  const countStatus = (status: AppointmentStatus) =>
    appointments.filter((item) => item.status === status).length;

  const isUpcoming = (appointment: Appointment): boolean =>
    ['SCHEDULED', 'CONFIRMED'].includes(appointment.status) &&
    new Date(appointment.scheduledStart).getTime() > currentTime;

  const isPast = (appointment: Appointment): boolean =>
    new Date(appointment.scheduledStart).getTime() <= currentTime;

  const upcomingAppointments = appointments.filter(isUpcoming);

  const sortedAppointments = [...appointments].sort(
    (a, b) =>
      new Date(a.scheduledStart).getTime() -
      new Date(b.scheduledStart).getTime(),
  );

  return (
    <Box>
      <Typography variant="h4" sx={{ fontWeight: 700, mb: 1 }}>
        Welcome, {user?.firstName || user?.username}
      </Typography>

      <Typography color="text.secondary" sx={{ mb: 3 }}>
        Patient Information Management System
      </Typography>

      <Alert severity="success" sx={{ mb: 3 }}>
        You have successfully signed in to PIMS.
      </Alert>

      <Grid container spacing={3}>
        {modules.map((module) => (
          <Grid key={module.title} size={{ xs: 12, sm: 6, lg: 3 }}>
            <Card sx={{ borderRadius: 3, height: '100%' }}>
              <CardContent sx={{ p: 3 }}>
                {module.icon}
                <Typography variant="h6" sx={{ mt: 2 }}>
                  {module.title}
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  Module interface coming next
                </Typography>
              </CardContent>
            </Card>
          </Grid>
        ))}
      </Grid>

      {canReadAppointments && (
        <Card sx={{ mt: 3, borderRadius: 3 }}>
          <CardContent>
            <Stack
              direction={{ xs: 'column', sm: 'row' }}
              spacing={2}
              sx={{
                mb: 3,
                justifyContent: 'space-between',
                alignItems: {
                  xs: 'flex-start',
                  sm: 'center',
                },
              }}
            >
              <Box>
                <Typography variant="h6" sx={{ fontWeight: 700 }}>
                  Appointments by Date
                </Typography>
                <Typography variant="body2" color="text.secondary">
                  {selectedDate} · Ethiopia local time
                </Typography>
              </Box>

              <Stack
                direction={{ xs: 'column', sm: 'row' }}
                spacing={2}
                sx={{ alignItems: 'center' }}
              >
                <TextField
                  label="Select Date"
                  type="date"
                  size="small"
                  value={selectedDate}
                  onChange={(event) =>
                    setSelectedDate(event.target.value)
                  }
                  slotProps={{
                    inputLabel: { shrink: true },
                  }}
                  sx={{ minWidth: 190 }}
                />

                <Button
                  variant="outlined"
                  startIcon={<RefreshIcon />}
                  onClick={() => void loadToday()}
                  disabled={loading || !selectedDate}
                >
                  Refresh
                </Button>
              </Stack>
            </Stack>

            {error && (
              <Alert severity="error" sx={{ mb: 2 }}>
                {error}
              </Alert>
            )}

            {patientError && canReadPatient && (
              <Alert severity="warning" sx={{ mb: 2 }}>
                Some patient details could not be loaded.
              </Alert>
            )}

            {loading ? (
              <Box sx={{ textAlign: 'center', py: 4 }}>
                <CircularProgress />
              </Box>
            ) : !error ? (
              <>
                <Box
                  sx={{
                    display: 'grid',
                    gridTemplateColumns: {
                      xs: 'repeat(1, minmax(0, 1fr))',
                      sm: 'repeat(2, minmax(0, 1fr))',
                      md: 'repeat(4, minmax(0, 1fr))',
                      lg: 'repeat(7, minmax(0, 1fr))',
                    },
                    gap: 2,
                    mb: 3,
                  }}
                >
                  {[
                    { label: 'Total', count: appointments.length },
                    { label: 'Upcoming', count: upcomingAppointments.length },
                    { label: 'Scheduled', count: countStatus('SCHEDULED') },
                    { label: 'Confirmed', count: countStatus('CONFIRMED') },
                    { label: 'Checked In', count: countStatus('CHECKED_IN') },
                    { label: 'Completed', count: countStatus('COMPLETED') },
                    {
                      label: 'Cancelled / No Show',
                      count:
                        countStatus('CANCELLED') +
                        countStatus('NO_SHOW'),
                    },
                  ].map((item) => (
                    <Box key={item.label} sx={{ minWidth: 0 }}>
                      <Card variant="outlined" sx={{ height: '100%' }}>
                        <CardContent>
                          <Typography
                            variant="body2"
                            color="text.secondary"
                          >
                            {item.label}
                          </Typography>
                          <Typography variant="h4" sx={{ mt: 1 }}>
                            {item.count}
                          </Typography>
                        </CardContent>
                      </Card>
                    </Box>
                  ))}
                </Box>

                <Typography
                  variant="subtitle1"
                  sx={{ fontWeight: 600, mb: 2 }}
                >
                  Daily Appointment Schedule
                </Typography>

                {sortedAppointments.length === 0 ? (
                  <Stack
                    spacing={1}
                    sx={{
                      py: 3,
                      alignItems: 'center',
                    }}
                  >
                    <EventNoteIcon
                      color="disabled"
                      sx={{ fontSize: 42 }}
                    />
                    <Typography color="text.secondary">
                      No appointments scheduled for the selected date.
                    </Typography>
                  </Stack>
                ) : (
                  <Stack spacing={1}>
                    {sortedAppointments.map((appointment) => (
                      <Stack
                        key={appointment.id}
                        direction={{ xs: 'column', sm: 'row' }}
                        spacing={1}
                        sx={{
                          p: 2,
                          border: '1px solid',
                          borderColor: 'divider',
                          borderRadius: 2,
                          backgroundColor: isUpcoming(appointment)
                            ? 'action.hover'
                            : 'transparent',
                          justifyContent: 'space-between',
                          alignItems: {
                            xs: 'flex-start',
                            sm: 'center',
                          },
                        }}
                      >
                        <Box>
                          <Typography sx={{ fontWeight: 600 }}>
                            {appointment.appointmentNumber}
                          </Typography>

                          <Typography variant="body2">
                            {getPatientName(appointment.patientId)}
                          </Typography>

                          <Typography
                            variant="caption"
                            color="text.secondary"
                          >
                            {getPatientIdentifier(appointment.patientId)}
                          </Typography>
                          <Typography
                            variant="body2"
                            color="text.secondary"
                          >
                            {formatTime(appointment.scheduledStart)}
                            {appointment.scheduledEnd
                              ? ` - ${formatTime(appointment.scheduledEnd)}`
                              : ''}
                          </Typography>
                        </Box>

                        <Stack
                          direction="row"
                          spacing={1}
                          sx={{ alignItems: 'center' }}
                        >
                          {isUpcoming(appointment) && (
                            <Chip
                              label="UPCOMING"
                              color="info"
                              variant="outlined"
                              size="small"
                            />
                          )}

                          {!isUpcoming(appointment) &&
                            isPast(appointment) &&
                            ['SCHEDULED', 'CONFIRMED'].includes(
                              appointment.status,
                            ) && (
                              <Chip
                                label="PAST START"
                                variant="outlined"
                                size="small"
                              />
                            )}

                          <Chip
                          label={appointment.status.replaceAll('_', ' ')}
                          color={
                            appointment.status === 'COMPLETED' ||
                            appointment.status === 'CHECKED_IN'
                              ? 'success'
                              : appointment.status === 'CANCELLED' ||
                                  appointment.status === 'NO_SHOW'
                                ? 'error'
                                : appointment.status === 'CONFIRMED'
                                  ? 'primary'
                                  : 'warning'
                          }
                          size="small"
                        />

                          <Button
                            size="small"
                            variant="outlined"
                            onClick={() =>
                              void handleViewDetails(appointment.id)
                            }
                          >
                            View
                          </Button>
                        </Stack>
                      </Stack>
                    ))}
                  </Stack>
                )}
              </>
            ) : null}
          </CardContent>
        </Card>
      )}

      {canReadAppointments && (
        <AppointmentDetailsDialog
          open={detailsOpen}
          appointment={selectedAppointment}
          patientName={
            selectedAppointment
              ? getPatientName(selectedAppointment.patientId)
              : undefined
          }
          patientIdentifier={
            selectedAppointment
              ? getPatientIdentifier(selectedAppointment.patientId)
              : undefined
          }
          loading={detailsLoading}
          error={detailsError}
          canUpdate={canUpdate}
          onManageStatus={() => {
            if (!canUpdate || !selectedAppointment) return;
            setDetailsOpen(false);
            setStatusOpen(true);
          }}
          onReschedule={() => {
            if (
              !canUpdate ||
              !selectedAppointment ||
              !['SCHEDULED', 'CONFIRMED'].includes(
                selectedAppointment.status,
              )
            ) return;

            setDetailsOpen(false);
            setRescheduleOpen(true);
          }}
          onClose={() => {
            setDetailsOpen(false);
            setSelectedAppointment(null);
            setDetailsError(null);
          }}
        />
      )}

      {canReadAppointments && canUpdate && (
        <>
          <AppointmentStatusDialog
            open={statusOpen}
            appointment={selectedAppointment}
            canCancel={canCancel}
            onClose={() => {
              setStatusOpen(false);
              setSelectedAppointment(null);
            }}
            onUpdated={() => {
              void loadToday();
            }}
          />

          <AppointmentRescheduleDialog
            open={rescheduleOpen}
            appointment={selectedAppointment}
            onClose={() => {
              setRescheduleOpen(false);
              setSelectedAppointment(null);
            }}
            onRescheduled={() => {
              void loadToday();
            }}
          />
        </>
      )}

      <Card sx={{ mt: 3, borderRadius: 3 }}>
        <CardContent>
          <Typography variant="h6" sx={{ mb: 2 }}>
            Your Access
          </Typography>
          <Typography>
            Roles: {user?.roles.join(', ') || 'None'}
          </Typography>
          <Typography sx={{ mt: 1 }}>
            Permissions: {user?.permissions.length ?? 0}
          </Typography>
        </CardContent>
      </Card>
    </Box>
  );
}